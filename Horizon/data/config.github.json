{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 50,
      "category": "tech-ai"
    },
    "rss": [],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 20,
          "category": "tech-ai"
        }
      ],
      "users": [],
      "fetch_comments": 3
    },
    "google_news": {
      "enabled": true,
      "query": "能源政策 OR 可再生能源 OR 碳中和 OR 电力改革",
      "language": "zh",
      "country": "CN",
      "ceid": null,
      "max_results": 30,
      "category": "energy-policy"
    },
    "gdelt": {
      "enabled": true,
      "query": "energy policy OR renewable energy OR carbon neutral OR solar power OR wind power OR electric vehicle",
      "mode": "ArtList",
      "max_records": 50,
      "timespan": null,
      "language": "english",
      "country": null,
      "category": "industry-news"
    }
  },
  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 24,
    "max_items": 20,
    "category_groups": {
      "energy-policy": {
        "name": "能源政策",
        "limit": 6,
        "categories": ["energy-policy", "renewable-energy", "carbon-neutral"]
      },
      "industry-news": {
        "name": "行业资讯",
        "limit": 6,
        "categories": ["industry-news", "energy-market"]
      },
      "tech": {
        "name": "科技动态",
        "limit": 6,
        "categories": ["tech-ai", "tech-innovation"]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": false
  }
}

{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 15,
      "min_score": 30,
      "category": "ai-tech"
    },
    "rss": [],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 3
    },
    "google_news": {
      "enabled": true,
      "query": "能源政策 OR 可再生能源 OR 碳中和 OR 电力改革 OR 国家电网 OR 中石油 OR 中石化 OR 光伏 OR 风电 OR 储能 OR 氢能 OR 核能 OR 新能源汽车 OR 碳排放",
      "language": "zh",
      "country": "CN",
      "ceid": null,
      "max_results": 60,
      "category": "energy"
    },
    "gdelt": {
      "enabled": true,
      "query": "Apple OR Google OR Microsoft OR Meta OR Amazon OR NVIDIA OR OpenAI OR Tesla OR Anthropic OR Huawei OR BYD OR CATL OR Alibaba OR Tencent OR ByteDance OR Baidu OR Xpeng OR NIO OR Li Auto OR Xiaomi",
      "mode": "ArtList",
      "max_records": 75,
      "timespan": null,
      "language": "english",
      "country": null,
      "category": "big-tech"
    }
  },
  "filtering": {
    "ai_score_threshold": 4.0,
    "time_window_hours": 24,
    "max_items": 20,
    "category_groups": {
      "energy": {
        "name": "能源资讯",
        "limit": 7,
        "categories": ["energy"]
      },
      "ai-tech": {
        "name": "AI科技",
        "limit": 5,
        "categories": ["ai-tech"]
      },
      "big-tech": {
        "name": "大厂动态",
        "limit": 7,
        "categories": ["big-tech"]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": false
  }
}

{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 15,
      "min_score": 30,
      "category": "ai-tech"
    },
    "rss": [
      {
        "name": "36氪",
        "url": "https://36kr.com/feed",
        "enabled": true,
        "category": "big-tech"
      },
      {
        "name": "虎嗅",
        "url": "https://www.huxiu.com/rss/0.xml",
        "enabled": true,
        "category": "big-tech"
      },
      {
        "name": "爱范儿",
        "url": "https://www.ifanr.com/feed",
        "enabled": true,
        "category": "big-tech"
      },
      {
        "name": "钛媒体",
        "url": "https://www.tmtpost.com/rss.xml",
        "enabled": true,
        "category": "big-tech"
      },
      {
        "name": "极客公园",
        "url": "https://www.geekpark.net/rss",
        "enabled": true,
        "category": "big-tech"
      },
      {
        "name": "新浪科技",
        "url": "https://tech.sina.com.cn/rss/news.xml",
        "enabled": true,
        "category": "big-tech"
      },
      {
        "name": "客服行业动态",
        "url": "https://news.google.com/rss/search?q=%E5%AE%A2%E6%9C%8D%20OR%20%E5%AE%A2%E6%88%B7%E6%9C%8D%E5%8A%A1%20OR%20%E6%99%BA%E8%83%BD%E5%AE%A2%E6%9C%8D%20OR%20%E5%91%BC%E5%8F%AB%E4%B8%AD%E5%BF%83%20OR%20%E5%AE%A2%E6%88%B7%E4%BD%93%E9%AA%8C&hl=zh-CN&gl=CN&ceid=CN:zh-Hans",
        "enabled": true,
        "category": "customer-service"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 3
    },
    "google_news": {
      "enabled": true,
      "query": "能源政策 OR 可再生能源政策 OR 碳中和 OR 碳达峰 OR 电力改革 OR 数字能源 OR 智能电网 OR 虚拟电厂 OR 新型电力系统 OR IEA OR OPEC OR 欧盟能源 OR 美国能源部",
      "language": "zh",
      "country": "CN",
      "ceid": null,
      "max_results": 40,
      "category": "energy"
    },
    "gdelt": {
      "enabled": false,
      "query": "",
      "mode": "ArtList",
      "max_records": 0,
      "timespan": null,
      "language": "english",
      "country": null,
      "category": "big-tech"
    }
  },
  "filtering": {
    "ai_score_threshold": 4.0,
    "time_window_hours": 24,
    "max_items": 40,
    "category_groups": {
      "energy": {
        "name": "能源政策资讯",
        "limit": 10,
        "categories": ["energy"]
      },
      "ai-tech": {
        "name": "AI 科技",
        "limit": 10,
        "categories": ["ai-tech"]
      },
      "big-tech": {
        "name": "大厂要闻",
        "limit": 10,
        "categories": ["big-tech"]
      },
      "customer-service": {
        "name": "客服行业动态",
        "limit": 10,
        "categories": ["customer-service"]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": false
  }
}

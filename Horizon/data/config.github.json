{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 15,
      "min_score": 30,
      "category": "ai-tech"
    },
    "rss": [],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "technology",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50,
          "category": "big-tech"
        }
      ],
      "users": [],
      "fetch_comments": 3
    },
    "google_news": {
      "enabled": true,
      "query": "能源政策 OR 碳中和 OR 电力改革 OR 新能源 OR 华为 OR 比亚迪 OR 阿里巴巴 OR 腾讯 OR 字节跳动 OR 小米 OR 百度 OR 宁德时代 OR 蔚来 OR 京东",
      "language": "zh",
      "country": "CN",
      "ceid": null,
      "max_results": 50,
      "category": "domestic"
    },
    "gdelt": {
      "enabled": false,
      "query": "",
      "mode": "ArtList",
      "max_records": 0,
      "timespan": null,
      "language": "english",
      "country": null,
      "category": "big-tech"
    }
  },
  "filtering": {
    "ai_score_threshold": 4.0,
    "time_window_hours": 24,
    "max_items": 20,
    "category_groups": {
      "domestic": {
        "name": "国内要闻",
        "limit": 8,
        "categories": ["domestic"]
      },
      "ai-tech": {
        "name": "AI 科技",
        "limit": 5,
        "categories": ["ai-tech"]
      },
      "big-tech": {
        "name": "国际大厂",
        "limit": 6,
        "categories": ["big-tech"]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": false
  }
}

{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 20,
      "min_score": 50
    },
    "rss": [],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 3
    },
    "google_news": {
      "enabled": true,
      "query": "能源政策 OR 可再生能源 OR 碳中和 OR 电力改革 OR 华为 OR 比亚迪 OR 宁德时代 OR 阿里巴巴 OR 腾讯 OR 百度 OR 字节跳动 OR 小米 OR 京东 OR 拼多多 OR 美团 OR 蔚来 OR 理想汽车 OR 小鹏汽车 OR 国家电网 OR 中石油 OR 中石化",
      "language": "zh",
      "country": "CN",
      "ceid": null,
      "max_results": 60,
      "category": "domestic"
    },
    "gdelt": {
      "enabled": true,
      "query": "energy policy OR renewable energy OR carbon neutral OR solar power OR wind power OR electric vehicle OR Apple OR Google OR Microsoft OR Meta OR Amazon OR NVIDIA OR OpenAI OR Tesla OR Anthropic OR DeepMind OR oil gas nuclear OPEC",
      "mode": "ArtList",
      "max_records": 75,
      "timespan": null,
      "language": "english",
      "country": null,
      "category": "international"
    }
  },
  "filtering": {
    "ai_score_threshold": 4.0,
    "time_window_hours": 24,
    "max_items": 20,
    "category_groups": {
      "domestic": {
        "name": "国内要闻",
        "limit": 9,
        "categories": ["domestic"]
      },
      "international": {
        "name": "国际要闻",
        "limit": 9,
        "categories": ["international"]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": false
  }
}

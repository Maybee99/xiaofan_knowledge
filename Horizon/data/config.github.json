{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 15,
      "min_score": 30,
      "category": "ai-tech"
    },
    "rss": [
      {
        "name": "36氪",
        "url": "https://36kr.com/feed",
        "enabled": true,
        "category": "big-tech"
      },
      {
        "name": "虎嗅",
        "url": "https://www.huxiu.com/rss/0.xml",
        "enabled": true,
        "category": "big-tech"
      },
      {
        "name": "爱范儿",
        "url": "https://www.ifanr.com/feed",
        "enabled": true,
        "category": "big-tech"
      },
      {
        "name": "钛媒体",
        "url": "https://www.tmtpost.com/rss.xml",
        "enabled": true,
        "category": "big-tech"
      },
      {
        "name": "极客公园",
        "url": "https://www.geekpark.net/rss",
        "enabled": true,
        "category": "big-tech"
      },
      {
        "name": "新浪科技",
        "url": "https://tech.sina.com.cn/rss/news.xml",
        "enabled": true,
        "category": "big-tech"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "technology",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50,
          "category": "big-tech"
        }
      ],
      "users": [],
      "fetch_comments": 3
    },
    "google_news": {
      "enabled": true,
      "query": "能源政策 OR 碳中和 OR 电力改革 OR 光伏 OR 风电 OR 储能 OR 新能源汽车 OR 国家电网 OR 新能源",
      "language": "zh",
      "country": "CN",
      "ceid": null,
      "max_results": 40,
      "category": "energy"
    },
    "gdelt": {
      "enabled": false,
      "query": "",
      "mode": "ArtList",
      "max_records": 0,
      "timespan": null,
      "language": "english",
      "country": null,
      "category": "big-tech"
    }
  },
  "filtering": {
    "ai_score_threshold": 4.0,
    "time_window_hours": 24,
    "max_items": 20,
    "category_groups": {
      "energy": {
        "name": "能源资讯",
        "limit": 7,
        "categories": ["energy"]
      },
      "ai-tech": {
        "name": "AI 科技",
        "limit": 5,
        "categories": ["ai-tech"]
      },
      "big-tech": {
        "name": "大厂要闻",
        "limit": 7,
        "categories": ["big-tech"]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": false
  }
}
